{
  "name": "@mumble-discord/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=src/gen --es_opt=target=ts,import_extension=none -I proto proto/Mumble.proto",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
