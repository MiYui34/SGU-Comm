# The official Mumble client on a virtual display, for server tests.
# trixie has Mumble 1.5; --build-arg DEBIAN=bookworm gives an older one.
ARG DEBIAN=trixie
FROM docker.io/library/debian:${DEBIAN}-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      mumble xvfb xdotool x11-utils imagemagick pulseaudio pulseaudio-utils \
      sqlite3 ca-certificates procps openssl \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m tester
USER tester
WORKDIR /home/tester
